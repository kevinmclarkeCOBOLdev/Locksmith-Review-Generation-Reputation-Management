# ==============================================================================
# LockReview Platform - Environment Configuration Template
# ==============================================================================

# --- 1. MySQL Database Configuration (Hostinger & Local - Shared with LockQuote) ---
DATABASE_URL=mysql://root:password@localhost:3306/lockquote

# Discrete MySQL Parameters (Alternative to DATABASE_URL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=lockquote

# --- 2. Application URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3001
APP_URL=http://localhost:3001
LOCKQUOTE_APP_URL=http://localhost:3000

# --- 3. Authentication & Security ---
JWT_SECRET=your_super_secret_jwt_hmac_key_min_32_characters
SESSION_COOKIE_NAME=session

# --- 4. Hostinger SMTP / Email Delivery ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=lockreview@atypikalstudio.dev
SMTP_PASSWORD=your_smtp_password
MAIL_FROM=lockreview@atypikalstudio.dev
EMAIL_FROM=LockReview <lockreview@atypikalstudio.dev>
EMAIL_REPLY_TO=support@atypikalstudio.dev
BUSINESS_EMAIL=support@atypikalstudio.dev

# --- 5. SMS Provider (Generic Gateway / Abstraction) ---
SMS_PROVIDER=generic
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=Locksmith

# --- 6. Scheduled Tasks & Automation Security ---
CRON_SECRET=your_secure_random_cron_secret_here
AUTOMATION_ENABLED=true
